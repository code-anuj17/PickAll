rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function authEmail() {
      return signedIn() && request.auth.token.email != null
        ? request.auth.token.email
        : "";
    }

    function isAdmin() {
      return signedIn() && authEmail() == "__ADMIN_EMAIL__";
    }

    function isSelf(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function hasRole(expectedRole) {
      return signedIn() && (
        (exists(/databases/$(database)/documents/Users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/Users/$(request.auth.uid)).data.role == expectedRole) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == expectedRole)
      );
    }

    function isMarketplaceOwner() {
      return signedIn() && (
        (resource.data.userId is string && resource.data.userId == request.auth.uid) ||
        (request.auth.token.email != null &&
          resource.data.ownerEmail is string &&
          resource.data.ownerEmail == request.auth.token.email) ||
        (request.auth.token.email != null &&
          resource.data.email is string &&
          resource.data.email == request.auth.token.email)
      );
    }

    // ---------- user profiles ----------
    match /users/{userId} {
      allow read: if isSelf(userId) || isAdmin();
      allow create: if isSelf(userId);
      allow update, delete: if isSelf(userId) || isAdmin();
    }

    match /Users/{userId} {
      allow read: if isSelf(userId) || isAdmin();
      allow create: if isSelf(userId);
      allow update, delete: if isSelf(userId) || isAdmin();
    }

    // ---------- public forms ----------
    match /quoteRequests/{docId} {
      allow create: if true;
      allow read, delete: if isAdmin();
      allow update: if false;
    }

    match /contactLeads/{leadId} {
      allow create: if true;
      allow read, delete: if isAdmin();
      allow update: if false;
    }

    // ---------- tracking ----------
    match /tracking/{trackId} {
      allow create: if true;
      allow get: if true;
      allow list: if isAdmin();
      allow update, delete: if isAdmin();
    }

    // ---------- orders ----------
    match /orders/{orderId} {
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow read: if (signedIn() && resource.data.userId == request.auth.uid) || isAdmin();
      allow update, delete: if isAdmin();
    }

    match /order/{orderId} {
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow read: if (signedIn() && resource.data.userId == request.auth.uid) || isAdmin();
      allow update, delete: if isAdmin();
    }

    // ---------- marketplace ----------
    match /loadAvailability/{docId} {
      allow read: if true;

      allow create: if
        signedIn() &&
        hasRole("business") &&
        request.resource.data.role == "business" &&
        request.resource.data.status == "open" &&
        request.resource.data.userId == request.auth.uid &&
        (
          !("ownerEmail" in request.resource.data) ||
          request.resource.data.ownerEmail == authEmail()
        );

      allow update, delete: if isMarketplaceOwner() || isAdmin();
    }

    match /truckAvailability/{docId} {
      allow read: if true;

      allow create: if
        signedIn() &&
        hasRole("truck-owner") &&
        request.resource.data.role == "truck-owner" &&
        request.resource.data.status == "open" &&
        request.resource.data.userId == request.auth.uid &&
        (
          !("ownerEmail" in request.resource.data) ||
          request.resource.data.ownerEmail == authEmail()
        );

      allow update, delete: if isMarketplaceOwner() || isAdmin();
    }

    // ---------- fake-load reports ----------
    match /loadPostReports/{reportId} {
      // reporter can create report, but never against self
      allow create: if
        signedIn() &&
        request.resource.data.reporterUserId == request.auth.uid &&
        (
          !("reportedUserId" in request.resource.data) ||
          request.resource.data.reportedUserId != request.auth.uid
        ) &&
        (
          !("ownerEmail" in request.resource.data) ||
          request.resource.data.ownerEmail != authEmail()
        );

      // reporter can read own reports; admin can read all
      allow read: if isAdmin() || (
        signedIn() && resource.data.reporterUserId == request.auth.uid
      );

      // admin-only moderation on report docs
      allow update, delete: if isAdmin();
    }
  }
}
