rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return request.auth.token.email == 'logisticspickall@gmail.com';
    }

    function getUserEmail() {
      return request.auth.token.email;
    }

    function getUserId() {
      return request.auth.uid;
    }

    function isOwnPost(creatorId, creatorEmail) {
      return getUserId() == creatorId || 
             getUserEmail() == creatorEmail;
    }

    // Load Availability Posts
    match /loadAvailability/{document=**} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && 
        (resource.data.userId == getUserId() || isAdmin());
    }

    // Truck Availability Posts
    match /truckAvailability/{document=**} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && 
        (resource.data.userId == getUserId() || isAdmin());
    }

    // Load Post Reports - Anyone can report, admin can moderate
    match /loadPostReports/{document=**} {
      allow create: if isAuthenticated() && 
        request.resource.data.reporterUserId == getUserId() &&
        request.resource.data.reporterUserId != request.resource.data.reportedUserId;
      allow read: if isAuthenticated() && 
        (isAdmin() || request.auth.uid == resource.data.reporterUserId);
      allow update, delete: if isAdmin();
    }

    // Truck Post Reports - Anyone can report, admin can moderate
    match /truckPostReports/{document=**} {
      allow create: if isAuthenticated() && 
        request.resource.data.reporterUserId == getUserId() &&
        request.resource.data.reporterUserId != request.resource.data.reportedUserId;
      allow read: if isAuthenticated() && 
        (isAdmin() || request.auth.uid == resource.data.reporterUserId);
      allow update, delete: if isAdmin();
    }

    // User Profiles (Users collection)
    match /Users/{userId} {
      allow read: if isAuthenticated();
      allow update: if isAuthenticated() && 
        (userId == getUserId() || isAdmin());
      allow create: if isAuthenticated() && userId == getUserId();
      allow delete: if isAdmin();
    }

    // User Profiles (users collection - fallback)
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow update: if isAuthenticated() && 
        (userId == getUserId() || isAdmin());
      allow create: if isAuthenticated() && userId == getUserId();
      allow delete: if isAdmin();
    }

    // Load Availability (alternative collection)
    match /Loads/{document=**} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAuthenticated();
    }

    // Truck Availability (alternative collection)
    match /Trucks/{document=**} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAuthenticated();
    }

    // Quote Requests
    match /quoteRequests/{document=**} {
      allow create: if isAuthenticated();
      allow read, update, delete: if isAuthenticated() && 
        (resource.data.userId == getUserId() || isAdmin());
    }

    // Contact Leads
    match /contactLeads/{document=**} {
      allow create: if true;
      allow read: if isAdmin();
      allow update, delete: if isAdmin();
    }

    // Tracking
    match /tracking/{document=**} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    // Orders
    match /orders/{document=**} {
      allow read, create, update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    // Order (singular)
    match /order/{document=**} {
      allow read, create, update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    // Load Post Availability (alternative)
    match /loadPostAvailability/{document=**} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && 
        (resource.data.userId == getUserId() || isAdmin());
    }

    // Truck Availability (alternative)
    match /truckPostAvailability/{document=**} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && 
        (resource.data.userId == getUserId() || isAdmin());
    }

    // Deny all other access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
